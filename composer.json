{
    "name": "estratos/domainname-api",
    "type": "symfony-bundle",
    "description": "Symfony bundle for DomainNameAPI/DomainResellerAPI integration with REST and SOAP support",
    "keywords": [
        "php",
        "symfony",
        "bundle",
        "domain",
        "domainnameapi",
        "domainresellerapi",
        "registrar",
        "rest",
        "soap"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Julio Rodriguez",
            "email": "julio.stratos@gmail.com"
        }
    ],
    "homepage": "https://github.com/estratos/domainname-api",
    "support": {
        "issues": "https://github.com/estratos/domainname-api/issues",
        "source": "https://github.com/estratos/domainname-api"
    },
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^5.4|^6.0|^7.0",
        "symfony/http-client": "^5.4|^6.0|^7.0",
        "symfony/serializer": "^5.4|^6.0|^7.0",
        "symfony/validator": "^5.4|^6.0|^7.0",
        "symfony/dependency-injection": "^5.4|^6.0|^7.0",
        "symfony/config": "^5.4|^6.0|^7.0",
        "symfony/console": "^5.4|^6.0|^7.0",
        "symfony/yaml": "^5.4|^6.0|^7.0",
        "symfony/expression-language": "^5.4|^6.0|^7.0"
    },
    "require-dev": {
        "symfony/http-kernel": "^5.4|^6.0|^7.0",
        "symfony/phpunit-bridge": "^6.0|^7.0",
        "phpunit/phpunit": "^9.5|^10.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpstan/phpstan-symfony": "^1.3",
        "friendsofphp/php-cs-fixer": "^3.0",
        "symfony/stopwatch": "^6.0|^7.0",
        "symfony/dotenv": "^5.4|^6.0|^7.0"
    },
    "suggest": {
        "domainreseller/php-dna": "Required for SOAP provider (legacy)",
        "ext-yaml": "Required for YAML output in commands",
        "ext-json": "Required for JSON handling"
    },
    "autoload": {
        "psr-4": {
            "Estratos\\DomainNameApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Estratos\\DomainNameApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        },
        "preferred-install": {
            "*": "dist"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "symfony": {
            "allow-contrib": false,
            "require": "^5.4|^6.0|^7.0"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Estratos\\DomainNameApi\\Scripts\\InstallScript::postInstall"
        ],
        "post-update-cmd": [
            "Estratos\\DomainNameApi\\Scripts\\InstallScript::postInstall"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "test-coverage": [
            "@php vendor/bin/phpunit --coverage-html coverage"
        ],
        "phpstan": [
            "@php vendor/bin/phpstan analyse src tests --level=max"
        ],
        "cs-fix": [
            "@php vendor/bin/php-cs-fixer fix src"
        ],
        "cs-check": [
            "@php vendor/bin/php-cs-fixer check src"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}