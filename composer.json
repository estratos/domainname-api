{
  "name": "estratos/domainname-api",
  "type": "symfony-bundle",
  "description": "Domain Name REST API Client for Symfony Framework",
  "keywords": ["php", "symfony", "domainname api", "domain registrar"],
  "license": "MIT",
  "authors": [
    {
      "name": "Julio Rodriguez",
      "email": "julio.stratos@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": { 
      "Estratos\\DomainNameApi\\": "src/",
      "DomainNameApi\\": "vendor/domainreseller/php-dna/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Estratos\\DomainNameApi\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "symfony/framework-bundle": "^5.4|^6.0|^7.0",
    "symfony/dependency-injection": "^5.4|^6.0|^7.0",
    "symfony/config": "^5.4|^6.0|^7.0",
    "symfony/console": "^5.4|^6.0|^7.0",
    "domainreseller/php-dna": "^2.0"
  },
  "require-dev": {
    "symfony/http-kernel": "^5.4|^6.0|^7.0",
    "phpunit/phpunit": "^9.5",
    "symfony/phpunit-bridge": "^6.0"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/estratos/domainname-api.git"
    }
  ],
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true
    },
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    },
    "symfony": {
      "allow-contrib": false,
      "require": "^5.4|^6.0|^7.0"
    }
  }
}